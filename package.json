{
  "name": "herdr-web-monorepo",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "link:cli": "npm install && npm link --workspace apps/web",
    "docker:up": "sh apps/web/scripts/docker.sh up",
    "docker:down": "sh apps/web/scripts/docker.sh down",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "preview": "npm run preview --workspace apps/web",
    "check": "biome ci .",
    "check:fix": "biome check --write .",
    "check:package": "npm run check:package --workspace apps/web",
    "check:font-assets": "npm run check:font-assets --workspace apps/web",
    "test": "npm run test --workspace apps/web --",
    "test:e2e": "npm run test:e2e --workspace apps/web --",
    "test:watch": "npm run test:watch --workspace apps/web --",
    "ci": "npm run check && npm run check:package && npm test && npm run build && npm run check:font-assets",
    "prepare": "husky"
  }
}
